# Copy to .env and fill in real values. vercel dev loads .env automatically.
OPENAI_API_KEY=sk-your-openai-key
GROQ_API_KEY=gsk_your-groq-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# MUST be 16+ chars or admin returns 503 misconfigured
ADMIN_PASS=change-me-to-a-long-secret-16plus

# Groq model defaults (llama-3.1-8b-instant primary, llama-3.3-70b-versatile fallback)
# GROQ_CHATBOT_MODEL=llama-3.1-8b-instant
# GROQ_CHATBOT_FALLBACK_MODEL=llama-3.3-70b-versatile
# GROQ_FLASHCARD_MODEL=llama-3.1-8b-instant
# GROQ_FLASHCARD_FALLBACK_MODEL=llama-3.3-70b-versatile
# DEBUG=true