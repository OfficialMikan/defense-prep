# Copy to .env and fill in real values. vercel dev loads .env automatically.
# ---------------------------------------------------------------------------
# AI PROVIDERS — set at least ONE of these.
# Groq is primary (fastest, free tier). OpenAI and OpenRouter are fallbacks.
# ---------------------------------------------------------------------------
# 1. GROQ (primary) — get a free API key at console.groq.com
#    Free tier: ~30K tokens/min for gpt-oss-120b, ~20K tokens/min for gpt-oss-20b.
GROQ_API_KEY=gsk_your-groq-key

# 2. OPENAI (optional fallback) — only used if Groq is unavailable.
#    Requires PAID credits: platform.openai.com/settings/organization/billing
#    If left blank, OpenAI is skipped (no 429 errors in logs).
# OPENAI_API_KEY=sk-your-openai-key

# 3. OPENROUTER (optional, additional free-tier fallback) — signup at openrouter.ai
#    Free $10 credit on signup. Uses the same openai/gpt-oss-* models.
#    This gives you a SEPARATE rate-limit bucket, tripling your effective
#    free capacity alongside Groq + OpenAI.
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# ---------------------------------------------------------------------------
# Groq model defaults (gpt-oss-120b primary, gpt-oss-20b fallback)
# Both models require the "openai/" prefix on Groq's API.
# 120b is used as PRIMARY for BOTH chatbot and flashcard (separate TPM buckets).
# ---------------------------------------------------------------------------
# GROQ_CHATBOT_MODEL=openai/gpt-oss-120b
# GROQ_CHATBOT_FALLBACK_MODEL=openai/gpt-oss-20b
# GROQ_FLASHCARD_MODEL=openai/gpt-oss-120b
# GROQ_FLASHCARD_FALLBACK_MODEL=openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# Embeddings — used for vector search in the research RAG pipeline.
# Default: OpenAI text-embedding-3-small (1536 dims, requires credits).
# If OPENAI_API_KEY is unset or has no credits, embeddings silently fail and
# the app falls back to keyword-only retrieval (no errors, just fewer results).
#
# For a FREE embeddings alternative:
#   - Set OPENAI_API_KEY to a Together.ai API key (free $25 credit)
#   - Set EMBEDDING_BASE_URL=https://api.together.ai/v1
#   - Set EMBEDDING_MODEL=sentence-transformers-all-minilm-l6-v2 (384 dims)
#   NOTE: changing dims requires a schema migration (vector(N) column).
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-your-openai-key  # same key reused for embeddings + fallback chat
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1/embeddings

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# MUST be 16+ chars or admin returns 503 misconfigured
ADMIN_PASS=change-me-to-a-long-secret-16plus

# DEBUG=true