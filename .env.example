# Copy to .env and fill in real values. vercel dev loads .env automatically.
OPENAI_API_KEY=sk-your-openai-key
GROQ_API_KEY=gsk_your-groq-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# MUST be 16+ chars or admin returns 503 misconfigured
ADMIN_PASS=change-me-to-a-long-secret-16plus

# Groq model defaults (gpt-oss-120b primary, gpt-oss-20b fallback)
# GROQ_CHATBOT_MODEL=gpt-oss-120b
# GROQ_CHATBOT_FALLBACK_MODEL=gpt-oss-20b
# GROQ_FLASHCARD_MODEL=gpt-oss-120b
# GROQ_FLASHCARD_FALLBACK_MODEL=gpt-oss-20b
# DEBUG=true